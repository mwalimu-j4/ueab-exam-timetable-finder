generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model TimetableVersion {
  id         String   @id @default(cuid())
  name       String
  pdfUrl     String?
  rowCount   Int
  isActive   Boolean  @default(false)
  uploadedAt DateTime @default(now())
  kind       String   @default("FINAL")
  label      String?
  publishedAt DateTime?
  exams      Exam[]
}

model Exam {
  id         String            @id @default(cuid())
  versionId  String
  date       DateTime
  dayName    String
  start      String
  end        String
  code       String
  title      String
  option     String?
  instructor String?
  building   String?
  venue      String?
  rows       Int?
  students   Int?
  version    TimetableVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@index([versionId])
  @@index([code])
  @@index([date])
}

model Visit {
  id        String @id @default(cuid())
  date      String
  visitorId String

  @@unique([date, visitorId])
}

enum EventType {
  SEARCH
  DOWNLOAD_PDF
  DOWNLOAD_ICS
  ADD_COURSE
}

model Event {
  id        String    @id @default(cuid())
  type      EventType
  query     String?
  createdAt DateTime  @default(now())
}

model Admin {
  id           String @id @default(cuid())
  email        String @unique
  passwordHash String
}

model Rating {
  id             String   @id @default(cuid())
  stars          Int
  comment        String?
  clientId       String
  userAgentType  String?
  createdAt      DateTime @default(now())

  @@index([createdAt])
  @@index([clientId])
}

model Student {
  id              String           @id @default(cuid())
  studentId       String           @unique
  pinHash         String
  failedAttempts  Int              @default(0)
  lockedUntil     DateTime?
  lastSeenVersionId String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  lastLoginAt     DateTime?
  sessions        StudentSession[]
  savedExams      SavedExam[]
}

model StudentSession {
  id           String   @id @default(cuid())
  studentRefId String
  tokenHash    String   @unique
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  lastUsedAt   DateTime @default(now())
  userAgentType String?
  student      Student  @relation(fields: [studentRefId], references: [id], onDelete: Cascade)

  @@index([studentRefId])
  @@index([expiresAt])
}

model SavedExam {
  id                String   @id @default(cuid())
  studentRefId      String
  code              String
  option            String
  isDone            Boolean  @default(false)
  doneAt            DateTime?
  addedAt           DateTime @default(now())
  lastKnownExamId   String?
  lastKnownSnapshot Json?
  changeFlag        String?
  changeSeenAt      DateTime?
  student           Student  @relation(fields: [studentRefId], references: [id], onDelete: Cascade)

  @@unique([studentRefId, code, option])
  @@index([studentRefId])
}
